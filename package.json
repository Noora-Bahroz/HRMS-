{
  "name": "hrms",
  "version": "1.0.0",
  "private": true,
  "description": "HRMS - production-ready Human Resource Management System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "postinstall": "npm run prisma:generate",
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace @hrms/server",
    "dev:web": "npm run dev --workspace @hrms/web",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace @hrms/server",
    "build:web": "npm run build --workspace @hrms/web",
    "test": "npm run test --workspace @hrms/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @hrms/server",
    "prisma:migrate": "npm run prisma:migrate --workspace @hrms/server",
    "prisma:seed": "npm run prisma:seed --workspace @hrms/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

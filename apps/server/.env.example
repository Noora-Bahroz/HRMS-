# Server environment (development defaults matching docker-compose infra)
NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose)
DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (optional for rate limiting/caching)
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=hrms
MINIO_SECRET_KEY=hrmsminio
MINIO_BUCKET=hrms-files
MINIO_USE_SSL=false

# RabbitMQ
RABBITMQ_URL=amqp://hrms:hrms@localhost:5672

# CORS
CORS_ORIGIN=http://localhost:5173

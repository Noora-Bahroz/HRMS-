{
  "version": 2,
  "builds": [
    {
      "src": "apps/server/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/server/api/index.ts" },
    { "source": "/health", "destination": "/apps/server/api/index.ts" },
    { "source": "/(.*)", "destination": "/apps/web/dist/index.html" }
  ]
}